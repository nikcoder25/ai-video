# Copy to .env and fill in. With MOCK=1 you can run the whole pipeline without keys.
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# Optional overrides
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
SCRIPT_MODEL=claude-opus-4-8

# Set to 1 to run the pipeline with canned scripts + synthetic timings (no API calls)
MOCK=0
