# --- APIs -------------------------------------------------------------------
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=

# Model used for clip selection. This prompt is the product; see pipeline/select.py
SELECT_MODEL=claude-sonnet-5

# --- Storage ----------------------------------------------------------------
# local | r2
STORAGE_BACKEND=local
STORAGE_DIR=./data/clips

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=clipviral
# Optional: public custom domain. If unset, presigned URLs are generated.
R2_PUBLIC_BASE_URL=

# --- App --------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/clipviral.db
WORK_DIR=./work
MAX_UPLOAD_MB=2048
# Comma-separated. Include every origin the browser may load the app from --
# "localhost" and "127.0.0.1" are different origins to a browser.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Run the whole pipeline with fixtures instead of real APIs. No keys needed.
MOCK=0

# --- Tuning -----------------------------------------------------------------
CLIP_MIN_SEC=20
CLIP_MAX_SEC=58
TARGET_CLIP_COUNT=10
# Only render candidates at or above this hook score. 0 renders everything.
MIN_HOOK_SCORE=6
RENDER_WIDTH=1080
RENDER_HEIGHT=1920
MAX_CLIP_MB=50

# --- Frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_BASE=http://localhost:8000
